# Self-hosted Omi backend — minimal viable set.
#
# Copy to backend/.env at deploy time. Everything here was confirmed against the source; the
# comments say what breaks without it. Anything not listed is optional and fails open.
#
# Design: this runs the app against YOUR OWN Firebase project, with on-device transcription
# doing the speech work. That combination removes the free-plan limits (300 transcription
# minutes, 30 chat questions, `is_locked` history) because those are values in a plan catalog
# this deployment owns, not a service you rent.

# ---------------------------------------------------------------------------
# Runtime stage
# ---------------------------------------------------------------------------
# `offline` keeps everything on the instance: instance-scoped filesystem storage instead of
# GCS buckets, and fake providers where a cloud key is absent. This is what removes the
# BUCKET_*/GOOGLE_APPLICATION_CREDENTIALS requirement for object storage.
OMI_ENV_STAGE=offline
PROVIDER_MODE=offline

# The unlock. Every allowance resolves unlimited and every plan counts as paid, so the
# client stops metering transcription and chat and stops rendering upgrade prompts
# (backend/utils/subscription.py: is_paid_plan + get_plan_limits). This is a switch the
# server operator owns, which is the whole reason to self-host; it is inert on any
# deployment that does not set it. `is_locked` is never written once nothing is exhausted.
OMI_SELFHOST_UNLIMITED=true

# Public HTTPS base URL of this deployment. OAuth callbacks are built from it, so it must be
# the address the phone can reach (https://<your-app>.fly.dev/).
# NO trailing slash: the code appends "/v1/auth/callback/google", and a trailing slash yields
# https://host//v1/... which Google rejects as a redirect_uri mismatch.
BASE_API_URL=https://CHANGE-ME.example

# >= 32 bytes. Encrypts stored transcripts and page cursors; startup refuses to serve without it.
# Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
ENCRYPTION_SECRET=CHANGE-ME-min-32-bytes

# ---------------------------------------------------------------------------
# Identity — your own Firebase project
# ---------------------------------------------------------------------------
# Service-account JSON (Firebase console -> Project settings -> Service accounts).
# Used to mint custom tokens and to read/write Firestore.
FIREBASE_AUTH_CREDENTIALS_PATH=/app/secrets/firebase-service-account.json
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=CHANGE-ME.firebaseapp.com
FIREBASE_AUTH_PROJECT_ID=CHANGE-ME

# Web OAuth client (NOT an iOS client). A web client has no bundle-id binding, which is why a
# sideloaded fork with its own bundle id can still sign in: the exchange happens server-side
# and the backend hands the app a Firebase custom token.
GOOGLE_CLIENT_ID=CHANGE-ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE-ME

# ---------------------------------------------------------------------------
# Speech-to-text
# ---------------------------------------------------------------------------
# iOS transcribes on-device (Apple SpeechAnalyzer), so no cloud STT is used for phone capture.
# This key still has to be non-empty: startup validates the streaming STT environment and
# aborts otherwise. Any placeholder works when PROVIDER_MODE=offline.
SONIOX_API_KEY=placeholder-not-used

# ---------------------------------------------------------------------------
# LLM — the only unavoidable per-use cost
# ---------------------------------------------------------------------------
# Drives memories, summaries and chat over already-transcribed text. Pick one.
OPENAI_API_KEY=
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Deliberately unset
# ---------------------------------------------------------------------------
# REDIS_DB_HOST          rate limiting / fair-use meters; fail-open when absent
# STRIPE_*               billing; irrelevant when you own the plan catalog
# PINECONE_*             semantic search; falls back when absent
# TYPESENSE_*            search index; optional
# POSTHOG_*              analytics; the on-device build forces its gate open instead
