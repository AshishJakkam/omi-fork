#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.release.xcconfig"
#include "Generated.xcconfig"
#include "Base.xcconfig"
#include "Custom.xcconfig"
// Keep production Google sign-in deterministic even when Custom.xcconfig is
// regenerated locally for a beta or developer build.
GOOGLE_REVERSE_CLIENT_ID=com.googleusercontent.apps.208440318997-ukinsq3sijhcetkhr26ssqp1terbq7as

ASSET_PREFIX=prod
BUNDLE_NAME=Omi
BUNDLE_DISPLAY_NAME=Omi
// --- fork identity (see ios/Flutter/devDebug.xcconfig for the rationale) ---
// Distinct bundle id + callback scheme so this build coexists with the App Store
// app. Sign-in goes through the backend's web OAuth flow (USE_WEB_AUTH=true),
// which accepts any registered custom scheme, so no Google client of our own is
// needed and the phone needs no local backend.
APP_BUNDLE_IDENTIFIER=com.openmind.app
AUTH_CALLBACK_SCHEME=openmind
BUNDLE_NAME=OpenMind
BUNDLE_DISPLAY_NAME=OpenMind

// whisper_flutter_new exposes one C entry point, `request`, which Dart reaches through
// DynamicLibrary.lookup rather than a normal reference. Release builds strip unreferenced symbols,
// so the function was removed from the binary and every transcription failed with
// "Failed to lookup symbol 'request': dlsym(RTLD_DEFAULT, request): symbol not found".
// -u keeps it, and pulls in the whisper/ggml objects it calls.
OTHER_LDFLAGS=$(inherited) -Wl,-u,_request