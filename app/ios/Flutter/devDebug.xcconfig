#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.debug-dev.xcconfig"
#include "Generated.xcconfig"
#include "Base.xcconfig"
#include "Custom.xcconfig"

ASSET_PREFIX=dev
BUNDLE_NAME=OpenMind
BUNDLE_DISPLAY_NAME=OpenMind
APP_BUNDLE_IDENTIFIER=com.openmind.app
// Must match AppEnvironmentProfile.localDev.authCallbackScheme in Dart: the app
// sends redirect_uri=<scheme>://auth/callback and listens for it on app_links,
// while this value is what Info.plist registers with the OS. Divergence means the
// callback never reaches the app.
AUTH_CALLBACK_SCHEME=omi-dev
INFOPLIST_FILE=Runner/Info-Dev.plist
GOOGLE_REVERSE_CLIENT_ID=com.googleusercontent.apps.1031333818730-dusn243nct6i5rgfpfkj5mchuj1qnmde
